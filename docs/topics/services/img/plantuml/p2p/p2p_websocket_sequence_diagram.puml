@startuml
skinparam backgroundColor #F0F8FF
skinparam defaultFontColor #333333
skinparam arrowColor #666666

' Define borders for all elements
skinparam entity {
  BorderColor #666666
  BackgroundColor #DDDDDD
}

skinparam control {
  BorderColor #666666
  BackgroundColor #DDDDDD
}

skinparam participant {
  BorderColor #666666
  BackgroundColor #DDDDDD
}




actor Client
control "Connection Handler" as Handler
database "Client Channels" as Channels
control "Notification Processor" as Processor

== New Client ==

Client -> Handler: Request WebSocket connection
activate Handler
Handler -> Handler: Check origin allow-list\nand connection caps
alt Cap reached or origin not allowed
    Handler --> Client: Reject (403 / 503)
else Admitted
    Handler -> Client: Upgrade to WebSocket,\nstart read and write pumps
    Handler -> Client: Queue initial node_status
    Handler -> Channels: Register client channel\n(with connection cancel)
end
deactivate Handler

== Notifications and Keepalive ==
loop WebSocket communication
    Processor -> Channels: Dispatch notification
    activate Processor
    loop Each client channel
        Channels --> Client: Send notification\n(write deadline per write)
    end
    deactivate Processor
    Handler --> Client: Keepalive ping (periodic)
    Client --> Handler: Pong (refreshes read deadline)
end

== Disconnect / Teardown ==
alt Client too slow to consume broadcasts
    Processor -> Channels: Broadcast send times out
    Channels -> Handler: Evict and cancel connection
else Read/write deadline missed or WebSocket error
    Handler -> Handler: Pump exits
else Client disconnects
    Client -> Handler: Close connection
end
Handler -> Channels: Remove client channel
Handler -> Handler: Close socket, join pumps,\nrelease connection slot

left footer Last Modified On: %date("dd-MMM-yyyy")

@enduml
