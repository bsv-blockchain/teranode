{{- /* Generated by compose/cmd/gennodes - DO NOT EDIT */ -}}
# Auto-generated overlay for a multinode teranode network ({{ .NodeCount }} nodes).
# Generated by compose/cmd/gennodes. Mounted into each container as
# /app/settings_local.conf. Stacks on top of /app/settings.conf via the
# context-layered settings system.

# Fixed admin credentials for this throwaway rig only. settings.conf no longer
# ships a pair, so generate-blocks.sh and multinode.sh need one here.
rpc_user = bitcoin
rpc_pass = bitcoin

{{- range .Nodes }}

# === teranode{{ .Index }} ===
clientName.docker.teranode{{ .Index }}                         = teranode{{ .Index }}
coinbase_arbitrary_text.docker.teranode{{ .Index }}            = /teranode{{ .Index }}/
blockchainDB.docker.teranode{{ .Index }}                       = teranode{{ .Index }}
blockchainDBUserPwd.docker.teranode{{ .Index }}                = miner{{ .Index }}
blockchain_store.docker.teranode{{ .Index }}.test              = postgres://miner{{ .Index }}:miner{{ .Index }}@postgres:${POSTGRES_PORT}/teranode{{ .Index }}
aerospike_host.docker.teranode{{ .Index }}                     = aerospike-{{ .Index }}
aerospike_port.docker.teranode{{ .Index }}                     = {{ .AerospikeServicePort }}
utxostore.docker.teranode{{ .Index }}.test                     = aerospike://aerospike-{{ .Index }}:{{ .AerospikeServicePort }}/test?set=utxo&WarmUp=32&ConnectionQueueSize=32&LimitConnectionsToQueueSize=true&MinConnectionsPerNode=8&externalStore=file://${DATADIR}/external
p2p_peer_id.docker.teranode{{ .Index }}                        = {{ .PeerID }}
p2p_private_key.docker.teranode{{ .Index }}                    = {{ .PrivateKey }}
# Alert is non-functional in this rig (its port is unexposed, it has no local
# bootstrap peers, and the regtest topic has no matching genesis keys), so keep
# it off - same as compose/settings_test.conf does for the other docker rigs.
startAlert.docker.teranode{{ .Index }}                         = false
{{- /*
  Static peers must name the container that actually runs p2p. In all-in-one
  that is "teranodeN"; in split mode there is no such container (a node is
  nine per-service siblings), so the bare name resolves to nothing and every
  dial fails with "no good addresses" — the mesh never forms and blocks never
  propagate. Emit ONE value, not an override later in the file: a duplicate
  key here is won by the first occurrence.
*/}}
{{- if $.AllInOne }}
p2p_static_peers.docker.teranode{{ .Index }}                   = {{ .StaticPeers }}
{{- else }}
p2p_static_peers.docker.teranode{{ .Index }}                   = {{ .StaticPeersSplit }}
{{- end }}
p2p_bootstrap_peers.docker.teranode{{ .Index }}.test           =
{{- if $.Retention.Emit }}
# --- retention / pruner profile: {{ $.Retention.Name }} ---
# ONE PLACE TO CHANGE: compose/cmd/gennodes/main.go, var aggressiveRetention.
# Production equivalents: 288 / 144 / 1440 / OnBlockPersisted / 10m / 10 / 10s.
#
# global_blockHeightRetention is the key that drives the delete-at-height
# stamp. utxostore_blockHeightRetention is parsed but UNUSED — see
# Settings.GetUtxoStoreBlockHeightRetention in settings/interface.go, which
# computes global + utxostore_blockHeightRetentionAdjustment.
global_blockHeightRetention.docker.teranode{{ .Index }}            = {{ $.Retention.BlockHeightRetention }}
utxostore_unminedTxRetention.docker.teranode{{ .Index }}           = {{ $.Retention.UnminedTxRetention }}
utxostore_parentPreservationBlocks.docker.teranode{{ .Index }}     = {{ $.Retention.ParentPreservationBlocks }}
startPruner.docker.teranode{{ .Index }}                            = true
pruner_block_trigger.docker.teranode{{ .Index }}                   = {{ $.Retention.BlockTrigger }}
pruner_min_block_height.docker.teranode{{ .Index }}                = 0
pruner_skipDuringCatchup.docker.teranode{{ .Index }}               = false
pruner_skipPreserveParents.docker.teranode{{ .Index }}             = false
pruner_skipProcessExpiredPreservations.docker.teranode{{ .Index }} = false
pruner_skipDeletions.docker.teranode{{ .Index }}                   = false
pruner_blockAssemblyWaitTimeout.docker.teranode{{ .Index }}        = {{ $.Retention.BAWaitTimeout }}
pruner_blobDeletionSafetyWindow.docker.teranode{{ .Index }}        = {{ $.Retention.BlobSafetyWindow }}
blockpersister_persistSleep.docker.teranode{{ .Index }}            = {{ $.Retention.PersistSleep }}
{{- end }}
# The block persister HTTP listener is loopback by default; both topologies
# publish its port, so it has to accept connections from outside the container.
# No token is set here, so its blob API stays read-only.
blockpersister_httpListenAddress.docker.teranode{{ .Index }}   = :${BLOCK_PERSISTER_HTTP_PORT}
{{- if not $.AllInOne }}
# Split topology: each service runs in its own container. Override the
# inter-service gRPC/HTTP addresses to dial the sibling container's DNS name
# instead of the all-in-one default ({{ "${clientName}" }}:port) which would
# resolve to the node-level container that doesn't exist in split mode.
#
# Also force useLocalValidator=false here: settings.conf ships with it set to
# true (suitable for the all-in-one default), which makes the daemon build an
# in-process validator and ignore validator_grpcAddress entirely. In split
# mode the standalone teranode{N}-validator container would then be dead code
# and per-service chaos against it (e.g. KillService on validator) would have
# no observable effect. Flipping the override makes split mode actually go
# through gRPC, which is the whole point of running a separate container.
useLocalValidator.docker.teranode{{ .Index }}                  = false
blockchain_grpcAddress.docker.teranode{{ .Index }}             = teranode{{ .Index }}-blockchain:${BLOCKCHAIN_GRPC_PORT}
blockassembly_grpcAddress.docker.teranode{{ .Index }}          = teranode{{ .Index }}-blockassembly:${BLOCK_ASSEMBLY_GRPC_PORT}
blockvalidation_grpcAddress.docker.teranode{{ .Index }}        = teranode{{ .Index }}-blockvalidation:${BLOCK_VALIDATION_GRPC_PORT}
subtreevalidation_grpcAddress.docker.teranode{{ .Index }}      = teranode{{ .Index }}-subtreevalidation:${SUBTREE_VALIDATION_GRPC_PORT}
validator_grpcAddress.docker.teranode{{ .Index }}              = teranode{{ .Index }}-validator:${VALIDATOR_GRPC_PORT}
propagation_grpcAddresses.docker.teranode{{ .Index }}          = teranode{{ .Index }}-propagation:${PROPAGATION_GRPC_PORT}
propagation_httpAddresses.docker.teranode{{ .Index }}          = http://teranode{{ .Index }}-propagation:${PROPAGATION_HTTP_PORT}
asset_httpAddress.docker.teranode{{ .Index }}                  = http://teranode{{ .Index }}-asset:${ASSET_HTTP_PORT}${asset_apiPrefix}
asset_propagation_proxy_address.docker.teranode{{ .Index }}    = http://teranode{{ .Index }}-propagation:${PROPAGATION_HTTP_PORT}
p2p_grpcAddress.docker.teranode{{ .Index }}                    = teranode{{ .Index }}-p2p:${P2P_GRPC_PORT}
# The p2p gRPC listener is loopback by default; in split mode the p2p service
# lives in its own container, so it has to accept connections from the sibling
# blockvalidation/subtreevalidation containers.
p2p_grpcListenAddress.docker.teranode{{ .Index }}              = :${P2P_GRPC_PORT}
{{- end }}
{{- end }}

# Shared: disable DHT bootstrap chatter for the local mesh; static peers are enough.
p2p_dht_mode = "client"
p2p_allow_private_ips = true
